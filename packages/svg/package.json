{
  "name": "@iconnook/svg",
  "version": "0.0.0",
  "private": true,
  "description": "SVG building and sanitization for IconNook (security-critical)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "jsdom": "30.1.3"
  },
  "devDependencies": {
    "@iconnook/config": "workspace:*",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
