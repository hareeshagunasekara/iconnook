{
  "name": "@iconnook/importer",
  "version": "0.0.0",
  "private": true,
  "description": "Imports open-source icon sets into IconNook (Postgres + Meilisearch)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/**'",
    "test:integration": "vitest run --dir test",
    "icons:import": "tsx --env-file-if-exists=../../.env src/cli/import.ts",
    "icons:reindex": "tsx --env-file-if-exists=../../.env src/cli/reindex.ts",
    "icons:catalog": "tsx src/cli/catalog.ts"
  },
  "dependencies": {
    "@iconify/json": "2.2.553",
    "@iconify/types": "2.0.0",
    "@iconify/utils": "3.1.7",
    "@iconnook/core": "workspace:*",
    "@iconnook/db": "workspace:*",
    "@iconnook/svg": "workspace:*",
    "drizzle-orm": "0.45.4",
    "meilisearch": "0.62.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconnook/config": "workspace:*",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
