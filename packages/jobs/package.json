{
  "name": "@iconnook/jobs",
  "version": "0.0.0",
  "private": true,
  "description": "Contract between the API (enqueues) and the worker (runs): queues, job schemas, flags, counters",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@iconnook/svg": "workspace:*",
    "ioredis": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconnook/config": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
