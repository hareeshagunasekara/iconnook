{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":pinVersions",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["before 6am on monday"],
  "timezone": "UTC",
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": { "enabled": true },
  "enabledManagers": ["npm", "github-actions"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "Group non-major updates into one weekly PR",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Group GitHub Actions updates (pinned to commit SHAs) into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "typescript-eslint and @astrojs/check support TypeScript < 6.1 only",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1"
    }
  ]
}
