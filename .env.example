# IconNook environment variables.
# Copy to .env (gitignored) and fill in. NEVER commit real values.
# Every variable is validated at startup; services refuse to start if one is missing or invalid.

NODE_ENV=development
LOG_LEVEL=info

# --- Public URLs ---
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_API_URL=http://localhost:8787

# --- API ---
API_PORT=8787

# --- PostgreSQL ---
DATABASE_URL=postgres://iconnook:change-me@localhost:5432/iconnook

# --- Meilisearch ---
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=change-me-at-least-16-chars

# --- Valkey (cache, rate limits, queue) ---
VALKEY_URL=redis://localhost:6379

# --- Object storage (MinIO locally, Cloudflare R2 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=iconnook-assets
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# --- Deployment (only needed on your machine / in CI secrets, Phase 8) ---
# CLOUDFLARE_API_TOKEN=
# HCLOUD_TOKEN=
