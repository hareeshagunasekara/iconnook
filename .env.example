# IconNook environment variables.
# Copy to .env (gitignored) and fill in. NEVER commit real values.
# Every variable is validated at startup; services refuse to start if one is missing or invalid.

NODE_ENV=development
LOG_LEVEL=info

# --- Public URLs ---
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_API_URL=http://localhost:8787

# --- API ---
API_PORT=8787
# Header with the real client IP, only when behind a proxy you trust (production: cf-connecting-ip)
# TRUST_PROXY_HEADER=
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_RENDER_PER_MINUTE=60

# --- PostgreSQL (POSTGRES_* configure the local Docker container) ---
POSTGRES_USER=iconnook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=iconnook
# Host port for the Docker container (use 5433 if a local Postgres already uses 5432)
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://iconnook:change-me@localhost:5432/iconnook

# --- Meilisearch ---
MEILI_URL=http://localhost:7700
# Key the API uses to query search: a search-only key in production; locally the master key is fine.
MEILI_API_KEY=change-me-at-least-16-chars
MEILI_MASTER_KEY=change-me-at-least-16-chars

# --- Valkey (cache, rate limits, queue) ---
VALKEY_URL=redis://localhost:6379

# --- Object storage (SeaweedFS locally, Cloudflare R2 in production) ---
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_BUCKET=iconnook-assets
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# --- Deployment (only needed on your machine / in CI secrets, Phase 8) ---
# CLOUDFLARE_API_TOKEN=
# HCLOUD_TOKEN=
