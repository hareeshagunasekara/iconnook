---
import SearchForm from '../components/SearchForm.astro';
import Layout from '../layouts/Layout.astro';

Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');
---

<Layout title="Page not found" description="This page doesn't exist." index={false}>
  <section class="mx-auto max-w-xl py-12 text-center">
    <h1 class="text-3xl font-bold">We couldn't find that page</h1>
    <p class="mt-3 text-[var(--color-text-muted)]">
      The icon or page may have moved, or the link has a typo. Try a search instead:
    </p>
    <div class="mt-6 text-left">
      <SearchForm id="notfound-search" />
    </div>
    <p class="mt-6">
      <a class="link" href="/">
        Home
      </a>{' '}
      ·{' '}
      <a class="link" href="/sets">
        All icon sets
      </a>
    </p>
  </section>
</Layout>
