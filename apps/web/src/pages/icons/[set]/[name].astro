---
import { PUBLIC_API_URL } from 'astro:env/client';

import ErrorState from '../../../components/ErrorState.astro';
import IconGrid from '../../../components/IconGrid.astro';
import LicenseBadge from '../../../components/LicenseBadge.astro';
import { IconEditor } from '../../../islands/IconEditor.tsx';
import { IconInfo } from '../../../islands/IconInfo.tsx';
import Layout from '../../../layouts/Layout.astro';
import { api, type Attribution, type IconDetail, type SearchResult } from '../../../lib/api';
import { assetUrl, inlineSvg, label } from '../../../lib/icons';

const SLUG = /^[a-z0-9]+(-[a-z0-9]+)*$/;
const { set = '', name = '' } = Astro.params;
if (!SLUG.test(set) || !SLUG.test(name)) return Astro.rewrite('/404');

let icon: IconDetail | null = null;
let attribution: Attribution | null = null;
let code = '';
let similar: SearchResult | null = null;
let failed = false;
try {
  icon = await api<IconDetail>(`/v1/icons/${set}/${name}`);
  if (icon) {
    const [a, c, s] = await Promise.all([
      api<Attribution>(`/v1/icons/${set}/${name}/attribution`),
      api<{ code: string }>(`/v1/icons/${set}/${name}/code`, { format: 'svg', size: 48 }),
      api<SearchResult>('/v1/search', { q: label(name), limit: 13 }).catch(() => null),
    ]);
    attribution = a;
    code = c?.code ?? '';
    similar = s;
  }
} catch {
  failed = true;
  Astro.response.status = 503;
}
if (!failed && !icon) return Astro.rewrite('/404');

const similarIcons = (similar?.items ?? [])
  .filter((i) => !(i.set === set && i.name === name))
  .slice(0, 12);
const hasStroke = Boolean(icon?.body.includes('stroke-width'));
const title = icon ? `${label(icon.name)} icon from ${icon.setInfo.name}` : 'Icon';
---

<Layout
  title={title}
  description={
    icon
      ? `Free “${label(icon.name)}” icon from ${icon.setInfo.name} (${icon.setInfo.license.spdx}). Download SVG or PNG, or copy as JSX, Vue, Svelte or CSS.`
      : 'Icon on IconNook.'
  }
  image={icon ? assetUrl(PUBLIC_API_URL, icon.set, icon.name, 'png', { size: 512 }) : undefined}
>
  {failed && <ErrorState title="This icon is temporarily unavailable" />}
  {icon && (
    <article>
      <nav aria-label="Breadcrumb" class="text-sm text-[var(--color-text-muted)]">
        <a class="link" href="/sets">
          Icon sets
        </a>{' '}
        ›{' '}
        <a class="link" href={`/sets/${icon.set}`}>
          {icon.setInfo.name}
        </a>{' '}
        › <span aria-current="page">{label(icon.name)}</span>
      </nav>
      <header class="mt-2 mb-6 flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-bold">{label(icon.name)}</h1>
        <LicenseBadge license={icon.setInfo.license} />
      </header>

      <IconEditor
        client:visible
        apiUrl={PUBLIC_API_URL}
        set={icon.set}
        name={icon.name}
        isColor={icon.setInfo.isColor}
        hasStroke={hasStroke}
        initialSvg={inlineSvg(icon)}
        iconId={icon.id}
      />
      <noscript>
        <details class="mt-4">
          <summary class="cursor-pointer font-semibold">SVG code</summary>
          <pre class="mt-2 max-h-80 overflow-auto rounded-lg bg-surface-2 p-3 text-xs whitespace-pre-wrap break-all"><code>{code}</code></pre>
        </details>
      </noscript>

      <div class="mt-8">
        <IconInfo icon={icon} attribution={attribution} />
      </div>

      {similarIcons.length > 0 && (
        <section aria-labelledby="similar" class="mt-8">
          <h2 id="similar" class="font-display text-xl font-bold">
            Similar icons
          </h2>
          <div class="mt-4">
            <IconGrid icons={similarIcons} name={`Icons similar to ${label(icon.name)}`} showSet />
          </div>
        </section>
      )}
    </article>
  )}
</Layout>
