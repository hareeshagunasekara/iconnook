---
import ErrorState from '../../components/ErrorState.astro';
import IconSetCard from '../../components/IconSetCard.astro';
import UiIcon from '../../components/UiIcon.astro';
import Layout from '../../layouts/Layout.astro';
import { api, SET_TYPES, typeLabel, type IconSet } from '../../lib/api';

const type = SET_TYPES.find((t) => t.value === Astro.url.searchParams.get('type'))?.value;
let sets: IconSet[] | null = null;
try {
  sets = await api<IconSet[]>('/v1/sets', { type });
} catch {
  Astro.response.status = 503;
}
const groups = SET_TYPES.map((t) => ({
  ...t,
  sets: (sets ?? []).filter((s) => s.type === t.value).sort((a, b) => b.total - a.total),
})).filter((g) => g.sets.length > 0);
---

<Layout
  title={type ? `${typeLabel(type)}: icon sets` : 'Icon sets'}
  description="Every open-source icon set on IconNook, with its license and number of icons."
>
  <h1 class="section-title">{type ? typeLabel(type) : 'All icon sets'}</h1>
  <nav aria-label="Filter by kind" class="mt-4">
    <ul class="flex flex-wrap gap-2">
      <li>
        <a href="/sets" aria-current={!type ? 'page' : undefined} class="pill">
          All
        </a>
      </li>
      {SET_TYPES.map((t) => (
        <li>
          <a
            href={`/sets?type=${t.value}`}
            aria-current={t.value === type ? 'page' : undefined}
            class="pill"
            style={`--pill: var(--color-${t.color}-soft)`}
          >
            <UiIcon name={t.icon} class="size-5" />
            {t.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {!sets && (
    <div class="mt-8">
      <ErrorState title="Icon sets are temporarily unavailable" />
    </div>
  )}

  {groups.map((group) => (
    <section aria-labelledby={`g-${group.value}`} class="mt-10">
      <h2 id={`g-${group.value}`} class="text-2xl font-bold">
        {group.label}{' '}
        <span class="text-base font-normal text-[var(--color-text-muted)]">
          ({group.sets.length})
        </span>
      </h2>
      <ul class="mt-5 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
        {group.sets.map((set, i) => (
          <li>
            <IconSetCard set={set} index={i} lazy />
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>

<style>
  .pill[aria-current='page'] {
    background: var(--color-ink);
    color: var(--color-cream);
  }
</style>
