---
import ErrorState from '../components/ErrorState.astro';
import Hero from '../components/home/Hero.astro';
import KindBrowser from '../components/home/KindBrowser.astro';
import PopularSets from '../components/home/PopularSets.astro';
import Layout from '../layouts/Layout.astro';
import { api, type IconSet } from '../lib/api';

let sets: IconSet[] | null = null;
try {
  sets = await api<IconSet[]>('/v1/sets');
} catch {
  Astro.response.status = 503;
}
const all = sets ?? [];
const totalIcons = all.reduce((n, s) => n + s.total, 0);
const popular = [...all]
  .filter((s) => s.type === 'ui' || s.type === 'color')
  .sort((a, b) => b.total - a.total)
  .slice(0, 12);
---

<Layout
  title="IconNook"
  description="Hundreds of thousands of free, open-source SVG icons from 190+ sets. Every icon clearly licensed. Copy as SVG, JSX, Vue or CSS, or download SVG and PNG."
>
  <Hero totalIcons={totalIcons} setCount={all.length} />

  {!sets && (
    <div class="mt-16">
      <ErrorState title="Icon sets are temporarily unavailable" />
    </div>
  )}

  {popular.length > 0 && (
    <div class="mt-16 lg:mt-20">
      <PopularSets sets={popular} total={all.length} />
    </div>
  )}

  <div class="mt-16 lg:mt-20">
    <KindBrowser />
  </div>
</Layout>
