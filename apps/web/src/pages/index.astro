---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="IconNook — free, open-source SVG icons"
  description="Hundreds of thousands of free, open-source SVG icons. Every icon clearly licensed."
>
  <section class="mx-auto flex max-w-2xl flex-col gap-4 px-4 py-24 text-center">
    <h1 class="text-4xl font-bold tracking-tight">IconNook</h1>
    <p class="text-lg text-[var(--color-text-muted)]">
      Free, open-source SVG icons — every one clearly licensed. Coming soon.
    </p>
    <p>
      <a
        class="text-[var(--color-accent)] underline underline-offset-4"
        href="https://github.com/hareeshagunasekara/iconnook"
      >
        Follow development on GitHub
      </a>
    </p>
  </section>
</BaseLayout>
