---
import { PUBLIC_API_URL } from 'astro:env/client';

import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative image for social cards. */
  image?: string | undefined;
  /** Set false for pages that shouldn't be indexed (search results, errors). */
  index?: boolean;
  /** Prefill the header search box. */
  query?: string;
}

const { title, description, image = '/og.png', index = true, query = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle =
  title === 'IconNook' ? 'IconNook — free, open-source SVG icons' : `${title} · IconNook`;
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!index && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href={new URL(PUBLIC_API_URL).origin} crossorigin />
    <meta property="og:site_name" content="IconNook" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-[var(--color-bg)] focus:px-4 focus:py-2 focus:shadow"
    >
      Skip to main content
    </a>
    <Header query={query} />
    <main
      id="main"
      tabindex="-1"
      class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 focus:outline-none"
    >
      <slot />
    </main>
    <Footer />
    <!-- Screen-reader announcements ("Copied", result counts) -->
    <div id="announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>
    <script>
      import '../scripts/shortcuts.ts';
      import '../scripts/grid-nav.ts';
    </script>
  </body>
</html>
