---
import headingFont from '../assets/fonts/bricolage-core.woff2?url';
import { PUBLIC_API_URL } from 'astro:env/client';

import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { IconModal } from '../islands/IconModal.tsx';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative image for social cards. */
  image?: string | undefined;
  /** Set false for pages that shouldn't be indexed (search results, errors). */
  index?: boolean;
  /** Prefill the header search box. */
  query?: string;
  /** Load the icon dialog (pages with icon tiles). The home page skips it to load faster. */
  iconModal?: boolean;
}

const {
  title,
  description,
  image = '/og.png',
  index = true,
  query = '',
  iconModal = true,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle =
  title === 'IconNook' ? 'IconNook: free, open-source SVG icons' : `${title} · IconNook`;
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!index && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Headings are the largest text on most pages: fetch their font early. -->
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href={new URL(PUBLIC_API_URL).origin} crossorigin />
    <meta property="og:site_name" content="IconNook" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <!-- "Back to top" target: the very top of the page (the sticky header is always on screen). -->
    <div id="top"></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:border-2 focus:border-ink focus:bg-surface focus:px-4 focus:py-2"
    >
      Skip to main content
    </a>
    <Header query={query} />
    <main id="main" tabindex="-1" class="wrap flex-1 py-8 focus:outline-none">
      <slot />
    </main>
    <Footer />
    {iconModal && <IconModal client:idle apiUrl={PUBLIC_API_URL} />}
    <!-- Screen-reader announcements ("Copied", result counts) -->
    <div id="announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>
    <script>
      import '../scripts/shortcuts.ts';
      import '../scripts/grid-nav.ts';
      import '../scripts/menu.ts';
      import '../scripts/search-suggest.ts';
    </script>
  </body>
</html>
