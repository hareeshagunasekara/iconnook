---
import UiIcon from './UiIcon.astro';

interface Props {
  query?: string;
  id: string;
  /** Header variant: smaller, no button (Enter submits). */
  compact?: boolean;
  /** Accessible name of the search landmark (must be unique per page). */
  landmark?: string;
}
const { query = '', id, compact = false, landmark = 'Search icons' } = Astro.props;
---

<form role="search" aria-label={landmark} action="/search" method="get" class="w-full">
  <label for={id} class="sr-only">
    Search icons
  </label>
  <div class="flex gap-2 sm:gap-3">
    <div class="relative min-w-0 flex-1">
      <UiIcon
        name="search"
        class:list={[
          'pointer-events-none absolute top-1/2 -translate-y-1/2 text-ink',
          compact ? 'left-3 size-5' : 'left-4 size-6',
        ]}
      />
      <input
        id={id}
        name="q"
        type="search"
        value={query}
        maxlength="100"
        autocomplete="off"
        placeholder="Search 370,000+ icons…"
        aria-describedby={compact ? undefined : `${id}-hint`}
        data-search-input
        class:list={[
          'input w-full placeholder:text-text-muted',
          compact ? 'pr-3 pl-10 text-base' : 'min-h-14 pr-4 pl-13 text-lg',
        ]}
      />
    </div>
    {!compact && (
      <button type="submit" class="btn-primary min-h-14 px-5 text-lg sm:px-7">
        Search
      </button>
    )}
  </div>
</form>
{!compact && (
  <p id={`${id}-hint`} class="mt-2 text-sm text-text-muted">
    Tip: press <kbd class="rounded border border-border bg-surface px-1">/</kbd> anywhere to search.
  </p>
)}
