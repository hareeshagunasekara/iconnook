---
import { UI_ICONS, type UiIconName } from '../lib/ui-icons';

interface Props {
  name: UiIconName;
  class?: string;
  strokeWidth?: number;
}
const { name, class: className = 'size-5', strokeWidth = 2 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={UI_ICONS[name]}
/>
