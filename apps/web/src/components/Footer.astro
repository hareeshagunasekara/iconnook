---
// Help lives in the same place on every page (WCAG 3.2.6 Consistent Help).
import Doodle from './Doodle.astro';
import Logo from './Logo.astro';
import UiIcon from './UiIcon.astro';

const REPO = 'https://github.com/hareeshagunasekara/iconnook';
const COLUMNS = [
  {
    title: 'Explore',
    color: 'mustard',
    links: [
      { label: 'All icon sets', href: '/sets' },
      { label: 'Browse by kind', href: '/sets#kinds' },
      { label: 'My collection', href: '/collection' },
      { label: 'Search icons', href: '/search' },
    ],
  },
  {
    title: 'Help',
    color: 'pink',
    links: [
      { label: 'Licenses & attribution FAQ', href: '/licenses' },
      { label: 'Report a problem', href: `${REPO}/issues` },
      { label: 'Report a security issue', href: `${REPO}/security/advisories/new` },
      { label: 'Contribute on GitHub', href: `${REPO}/blob/main/CONTRIBUTING.md` },
    ],
  },
  {
    title: 'Legal',
    color: 'blue',
    links: [
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms of Use', href: '/terms' },
      { label: 'Licensing', href: '/licenses' },
      { label: 'Open-source code', href: REPO },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="mt-16 lg:mt-20">
  <div class="wrap relative">
    <Doodle kind="burst" class="absolute -top-3 right-6 hidden size-9 rotate-[100deg] sm:block" />
    <p class="border-b-2 border-ink pb-3 text-xs font-bold tracking-[0.12em] text-purple uppercase">
      IconNook / the bottom of the page
    </p>

    <div class="relative grid gap-10 py-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:gap-0">
      <Doodle
        kind="sparkle"
        color="mustard"
        class="absolute top-1/2 -right-2 hidden size-10 -translate-y-1/2 xl:block"
      />
      <div class="lg:border-r-2 lg:border-ink lg:pr-10">
        <div class="flex items-center gap-4">
          <Logo size={72} />
          <span class="relative font-display text-3xl font-extrabold tracking-[-0.03em]">
            IconNook
            <Doodle kind="swoosh" color="pink" class="absolute -bottom-2.5 left-0 h-2 w-[95%]" />
          </span>
        </div>
        <p class="mt-6 font-display text-2xl font-extrabold">Free icons. Zero fuss.</p>
        <p class="mt-2 text-text-muted">
          Open-source SVGs, clearly licensed.
          <br />
          No sign-up. No payments. Just create.
        </p>
        <a
          href={REPO}
          class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-[var(--radius-button)] bg-ink px-4 font-semibold text-cream hover:bg-purple"
        >
          <UiIcon name="github" class="size-5" />
          View on GitHub
          <UiIcon name="arrow-up-right" class="size-4" />
        </a>
      </div>

      <div class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3 lg:pl-10 xl:pr-10">
        {COLUMNS.map((column) => (
          <nav aria-label={column.title}>
            <span
              class="block h-1.5 w-8 rounded-full"
              style={`background: var(--color-${column.color})`}
              aria-hidden="true"
            />
            <p class="mt-4 font-display text-xl font-bold">{column.title}</p>
            <ul class="mt-3 space-y-1">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="footer-link">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border-t-2 border-ink py-5 text-sm">
      <p class="flex flex-wrap items-center gap-x-6 gap-y-1">
        <span class="font-bold">© {year} IconNook</span>
        <span class="text-text-muted">Made for everyone.</span>
      </p>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <span class="inline-flex items-center gap-2 font-bold">
          <UiIcon name="shield-check" class="size-5 text-green" />
          Code: Apache 2.0
        </span>
        <span class="text-text-muted">· Icons keep their original licenses</span>
      </p>
      <a
        href="#top"
        class="pop-card inline-flex min-h-11 items-center gap-1.5 px-4 font-semibold"
        style="--pop: var(--color-purple)"
      >
        Back to top
        <UiIcon name="arrow-up" class="size-4" />
      </a>
    </div>

    <div class="flex items-center justify-between gap-4 pb-8">
      <span class="flex gap-2" aria-hidden="true">
        <span class="size-2.5 rounded-full bg-coral"></span>
        <span class="size-2.5 rounded-full bg-pink"></span>
        <span class="size-2.5 rounded-full bg-mustard"></span>
      </span>
      <p class="text-xs font-bold tracking-[0.12em] text-purple uppercase">
        Forever free · Open by design
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    font-weight: 500;
  }
  .footer-link:hover {
    border-bottom-color: var(--color-ink);
  }
</style>
