---
// Help lives in the same place on every page (WCAG 3.2.6 Consistent Help).
---

<footer class="mt-16 border-t border-[var(--color-surface-2)] bg-[var(--color-surface)]">
  <div class="mx-auto grid max-w-6xl gap-6 px-4 py-8 text-sm sm:grid-cols-3">
    <div>
      <p class="font-semibold">IconNook</p>
      <p class="mt-1 text-[var(--color-text-muted)]">
        Free, open-source SVG icons. Every icon clearly licensed. No sign-up, no payments.
      </p>
    </div>
    <nav aria-label="Help">
      <p class="font-semibold">Help</p>
      <ul class="mt-1 space-y-1">
        <li>
          <a class="link" href="/licenses">
            Licenses &amp; attribution FAQ
          </a>
        </li>
        <li>
          <a class="link" href="https://github.com/hareeshagunasekara/iconnook/issues">
            Report a problem
          </a>
        </li>
        <li>
          <a
            class="link"
            href="https://github.com/hareeshagunasekara/iconnook/security/advisories/new"
          >
            Report a security issue
          </a>
        </li>
      </ul>
    </nav>
    <div>
      <p class="font-semibold">Open source</p>
      <ul class="mt-1 space-y-1">
        <li>
          <a class="link" href="https://github.com/hareeshagunasekara/iconnook">
            Source code
          </a>{' '}
          (Apache-2.0)
        </li>
        <li>Icons keep their original licenses, shown on every icon page.</li>
      </ul>
    </div>
  </div>
</footer>
