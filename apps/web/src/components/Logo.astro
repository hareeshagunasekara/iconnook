---
interface Props {
  /** Size of the mark in px; the wordmark scales with it. */
  size?: number;
}
const { size = 34 } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <img src="/favicon.svg" alt="" width={size} height={size} />
  <span
    class="font-display font-extrabold tracking-[-0.02em]"
    style={`font-size: ${String(size * 0.7)}px`}
  >
    IconNook
  </span>
</span>
