---
/** The IconNook logo (its "ICON NOOK" lettering is the wordmark). Sources: src/assets/brand. */
interface Props {
  /** Rendered size in CSS px. */
  size?: number;
  /** Empty when a surrounding link already names it (e.g. "IconNook home"). */
  alt?: string;
  /** "lazy" below the fold (the footer); the header logo loads right away. */
  loading?: 'eager' | 'lazy';
}
const { size = 48, alt = '', loading = 'eager' } = Astro.props;

const files = import.meta.glob<string>('../assets/brand/iconnook-logo-*.{avif,webp}', {
  eager: true,
  query: '?url',
  import: 'default',
});
const url = (px: number, format: 'avif' | 'webp') => {
  const file = files[`../assets/brand/iconnook-logo-${String(px)}.${format}`];
  if (!file)
    throw new Error(`Missing iconnook-logo-${String(px)}.${format}: run the images script`);
  return file;
};
// Pick the smallest file that is at least `size` × density.
const srcset = (format: 'avif' | 'webp') =>
  [1, 2, 3]
    .map((density) => {
      const px = [64, 128, 192].find((w) => w >= size * density) ?? 192;
      return `${url(px, format)} ${String(density)}x`;
    })
    .join(', ');
---

<picture class="shrink-0">
  <source type="image/avif" srcset={srcset('avif')} />
  <source type="image/webp" srcset={srcset('webp')} />
  <img
    src={url(128, 'webp')}
    alt={alt}
    width={size}
    height={size}
    loading={loading}
    decoding="async"
    class="block"
  />
</picture>
