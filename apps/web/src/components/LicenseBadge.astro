---
import type { License } from '../lib/api';

interface Props {
  license: License;
  /** A smaller, quieter pill for long lists, where it shouldn't draw the eye. */
  subtle?: boolean;
}
const { license, subtle = false } = Astro.props;
// Never color alone (WCAG 1.4.1): the text says what the tier means.
const meaning = license.attributionRequired
  ? license.tier === 'C'
    ? 'Credit + share-alike'
    : 'Credit required'
  : 'No attribution needed';
const fill = {
  A: 'var(--color-green-pale)',
  B: 'var(--color-mustard-pale)',
  C: 'var(--color-pink-pale)',
}[license.tier];
---

{subtle ? (
  <span
    class="inline-flex w-fit max-w-full flex-wrap items-center gap-x-1 self-start rounded-full border border-ink/20 px-2 py-px text-[0.6875rem] font-medium text-text-muted"
    style={`background: ${fill}`}
  >
    <span>{license.spdx}</span>
    <span aria-hidden="true">·</span>
    <span>{meaning}</span>
  </span>
) : (
  <span
    class="inline-flex w-fit max-w-full flex-wrap items-center gap-x-1.5 self-start rounded-full border-[1.5px] border-ink px-2.5 py-0.5 text-xs font-semibold text-ink"
    style={`background: ${fill}`}
  >
    <span>{license.spdx}</span>
    <span aria-hidden="true">·</span>
    <span>{meaning}</span>
  </span>
)}
