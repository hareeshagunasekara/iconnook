{
  "name": "@iconnook/api",
  "version": "0.0.0",
  "private": true,
  "description": "IconNook public REST API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/**'",
    "test:integration": "vitest run --dir test"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@hono/zod-openapi": "1.6.3",
    "@iconnook/core": "workspace:*",
    "@iconnook/db": "workspace:*",
    "@iconnook/jobs": "workspace:*",
    "@iconnook/search": "workspace:*",
    "@iconnook/storage": "workspace:*",
    "@iconnook/svg": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "bullmq": "6.6.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "ioredis": "6.0.0",
    "meilisearch": "0.62.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconnook/config": "workspace:*",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
