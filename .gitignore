# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.age
age.key
kubeconfig*
*.kubeconfig
.kube/
# Plaintext k8s secrets (only SOPS-encrypted *.enc.yaml may be committed)
deploy/**/secret*.yaml
!deploy/**/*.enc.yaml

# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Build output ---
dist/
build/
.astro/
.output/
*.tsbuildinfo

# --- Tooling caches ---
.turbo/
.cache/
.eslintcache
.vite/

# --- Tests & reports ---
coverage/
playwright-report/
test-results/
blob-report/
.lighthouseci/
k6-results/

# --- Local data (docker volumes, imports) ---
.data/
*.dump
*.sql.gz

# --- Logs ---
*.log
npm-debug.log*
pnpm-debug.log*

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# --- Claude Code local settings (shared settings.json is fine) ---
.claude/settings.local.json
